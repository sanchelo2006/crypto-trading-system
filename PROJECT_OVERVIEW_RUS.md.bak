-100, -24)"><rect></rect><foreignObject width="200" height="48"><div xmlns="http://www.w3.org/1999/xhtml" style="display: table; white-space: break-spaces; line-height: 1.5; max-width: 200px; text-align: center; width: 200px;"><span class="nodeLabel"><p>Split into N walk-forward folds</p></span></div></foreignObject></g></g><g class="node default" id="flowchart-L-25" transform="translate(497.39322662353516, 1462.1875)"><rect class="basic label-container" style="" x="-79.00521087646484" y="-27" width="158.0104217529297" height="54"></rect><g class="label" style="" transform="translate(-49.005210876464844, -12)"><rect></rect><foreignObject width="98.01042175292969" height="24"><div xmlns="http://www.w3.org/1999/xhtml" style="display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;"><span class="nodeLabel"><p>Iteration loop</p></span></div></foreignObject></g></g><g class="node default" id="flowchart-M-27" transform="translate(138, 1602.1875)"><rect class="basic label-container" style="" x="-130" y="-39" width="260" height="78"></rect><g class="label" style="" transform="translate(-100, -24)"><rect></rect><foreignObject width="200" height="48"><div xmlns="http://www.w3.org/1999/xhtml" style="display: table; white-space: break-spaces; line-height: 1.5; max-width: 200px; text-align: center; width: 200px;"><span class="nodeLabel"><p>Evaluate spec on TRAIN+TEST per fold</p></span></div></foreignObject></g></g><g class="node default" id="flowchart-N-29" transform="translate(138, 1767.859375)"><rect class="basic label-container" style="" x="-125.61458587646484" y="-27" width="251.2291717529297" height="54"></rect><g class="label" style="" transform="translate(-95.61458587646484, -12)"><rect></rect><foreignObject width="191.2291717529297" height="24"><div xmlns="http://www.w3.org/1999/xhtml" style="display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;"><span class="nodeLabel"><p>Aggregate + score + robust</p></span></div></foreignObject></g></g><g class="node default" id="flowchart-O-31" transform="translate(138, 1945.53125)"><rect class="basic label-container" style="" x="-126.41667175292969" y="-27" width="252.83334350585938" height="54"></rect><g class="label" style="" transform="translate(-96.41667175292969, -12)"><rect></rect><foreignObject width="192.83334350585938" height="24"><div xmlns="http://www.w3.org/1999/xhtml" style="display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;"><span class="nodeLabel"><p>Local search: 30 mutations</p></span></div></foreignObject></g></g><g class="node default" id="flowchart-P-33" transform="translate(138, 2104.046875)"><polygon points="81.515625,0 163.03125,-81.515625 81.515625,-163.03125 0,-81.515625" class="label-container" transform="translate(-81.015625, 81.515625)"></polygon><g class="label" style="" transform="translate(-54.515625, -12)"><rect></rect><foreignObject width="109.03125" height="24"><div xmlns="http://www.w3.org/1999/xhtml" style="display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;"><span class="nodeLabel"><p>Score dropped?</p></span></div></foreignObject></g></g><g class="node default" id="flowchart-Q-35" transform="translate(348.1848945617676, 2286.5625)"><rect class="basic label-container" style="" x="-87.515625" y="-27" width="175.03125" height="54"></rect><g class="label" style="" transform="translate(-57.515625, -12)"><rect></rect><foreignObject width="115.03125" height="24"><div xmlns="http://www.w3.org/1999/xhtml" style="display: table-cell; white-space: nowrap; line-height: 1.5; max-width: 200px; text-align: center;"><span class="nodeLabel"><p>Rollback to best</p></span></div></foreignObject></g></g><g class="node default" id="flowchart-R-37" transform="translate(138, 2390.5625)"><rect class="basic label-container" style="" x="-99.203125" y="-27" width="198.40625" height="54"></rect><g class="labe